[Unit]
Description=lightwispr dictation daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/lightwispr daemon
Restart=on-failure
RestartSec=2
# Room for the speech model plus the enhancement worker (same cgroup); stops a runaway.
MemoryMax=8G

[Install]
WantedBy=graphical-session.target
